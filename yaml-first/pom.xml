<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.os890.sketch</groupId>
    <artifactId>openapi-jakarta10-dto-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>yaml-first</artifactId>
  <packaging>jar</packaging>

  <name>yaml-first</name>
  <description>DTO generation from a hand-written OpenAPI YAML spec</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-dtos</id>
            <configuration>
              <!-- the hand-written spec; everything else is inherited from the parent -->
              <inputSpec>${project.basedir}/src/main/openapi/petstore.yaml</inputSpec>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
