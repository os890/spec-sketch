<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.os890.sketch</groupId>
    <artifactId>openapi-jakarta10-dto-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>sketch-first</artifactId>
  <packaging>jar</packaging>

  <name>sketch-first</name>
  <description>DTO generation from a custom SpecSketch DSL, translated to OpenAPI YAML by a single-file Java generator</description>

  <build>
    <plugins>
      <!--
        Step 1 (generate-sources phase, declared BEFORE the openapi generator so it runs first):
        run the dependency-free single-file generator via the JDK's source-code launcher
        (no prior compilation needed) to translate the SpecSketch file to OpenAPI YAML.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>sketch-generate-openapi</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/src/main/tools/SpecSketchGenerator.java</argument>
                <argument>${project.basedir}/src/main/sketch/petstore.sketch</argument>
                <argument>${project.basedir}/target/generated-openapi/petstore.yaml</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Compile the single-file generator into the module: src/main/tools is added as a
        source root, so SpecSketchGeneratorTest can call it AND the generator ships in the
        module's jar, which is made runnable below (java -jar target/sketch-first-*.jar).
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generator-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/main/tools</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- make the module jar runnable: java -jar target/sketch-first-*.jar <input.sketch> -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>SpecSketchGenerator</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Step 2: same DTO generation as in the other modules, only the inputSpec differs -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-dtos</id>
            <configuration>
              <!-- the OpenAPI file emitted by SpecSketchGenerator -->
              <inputSpec>${project.basedir}/target/generated-openapi/petstore.yaml</inputSpec>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
